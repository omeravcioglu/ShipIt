<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the Unity EditMode test sources (Assets/IndieStudio/Simulation/Tests) with plain dotnet:
    `dotnet test SimHarness/Tests`. The same files also run inside Unity's Test Runner.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>IndieStudio.Simulation.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\IndieStudio\Simulation\Tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IndieStudio.Simulation.csproj" />
  </ItemGroup>
</Project>
